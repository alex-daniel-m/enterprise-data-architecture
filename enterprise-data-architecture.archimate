      <property key="ads" value="ads @relation(fields: [ads_id], references: [id], onDelete: Cascade)"/>
      <property key="languages_code" value="String @db.VarChar(3)"/>
      <property key="languages" value="languages @relation(fields: [languages_code], references: [code], onDelete: Restrict)"/>
      <property key="pk_ads_languages" value="@@id([ads_id, languages_code], map: &quot;pk_ads_languages&quot;)"/>
